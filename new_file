def dfs_n_queens(n):
    if n < 1:
        return [] 
    solutions = []
    def is_safe(row, col, current):
        for r in range(row):
            c = current[r]
            if c == col:
                return False

            if abs(r - row) == abs(c - col):
                return False 
    
        return True 
    
    def dfs(row, current):
        if row == n:
            solutions.append(current[:])
            return 

        for col in range(n):
            if is_safe(row, col, current):
                current.append(col)
                dfs(row +1, current)
                current.pop() 


    dfs(0,[])
    return solutions 