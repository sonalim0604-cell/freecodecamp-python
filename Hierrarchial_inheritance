class Cone:
    def __init__(self, radius, height, base):
        self.radius = radius
        self.height = height
        self.base = base

    def base_area(self):
        return 3.14 * self.radius ** 2

    def circumference(self):
        return 2 * 3.14 * self.radius

class Volume(Cone):
    def __init__(self, radius,height,base):
        super().__init__(radius, height, base)
    def volume(self):
        return self.base_area() * self.height/ 3

class SurfaceArea(Cone):
    def __init__(self, radius,height,base):
        super().__init__( radius, height, base)
    def surface_area(self):
        return self.base_area() + 0.5 * self.circumference() * self.base
